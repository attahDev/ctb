DATABASE_URL=postgresql://postgres:postgres@db:5432/glorytime
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-this-to-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FIRST_SUPERADMIN_EMAIL=admin@glorytime.church
FIRST_SUPERADMIN_PASSWORD=change-this-password

FRONTEND_ORIGIN=http://localhost:3000

# Brevo transactional email — SMTP relay, drop-in compatible with the
# existing smtplib-based sender. Get the SMTP key from Brevo > SMTP & API.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
SMTP_FROM=no-reply@glorytime.church

# Supabase Storage — used for admin image uploads (events, partner logos).
# Create a public bucket (default name "media") and use the *service role*
# key here, never the anon key — it's server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_BUCKET=media
